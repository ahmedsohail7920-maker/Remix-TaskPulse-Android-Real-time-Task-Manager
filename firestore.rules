rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "ahmed.sohail.7920@gmail.com";
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'priority', 'status', 'isCompleted']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 250 &&
        data.priority in ['low', 'medium', 'high', 'urgent'] &&
        data.status in ['todo', 'in_progress', 'completed', 'archived'] &&
        data.isCompleted is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 64)) &&
        (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 64)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 20));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'color']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
        data.color is string && data.color.size() <= 32;
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(taskId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(categoryId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // User Device Tokens
    match /users/{userId}/tokens/{tokenId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId) && isValidId(tokenId);
    }
  }
}
